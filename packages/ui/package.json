{
  "name": "darbit-ui",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "The web UI of darbit: the hub, capture, highlight, recorder and run panel",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "node scripts/check-tokens.ts && node scripts/check-contrast.ts && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "storybook": "storybook dev --port 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build --output-dir storybook-static"
  },
  "dependencies": {
    "konva": "10.7.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/svelte-vite": "10.6.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "storybook": "10.6.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
